"kind":"annotation","normalization":null,"positionSource":null,"source":"# Euler's line\nIn any triangle the orthocentre $O$, the circumcentre $K$, and the centroid $G$ are collinear. A perpendicular through a point is the inner product $a \\cdot A$; the sum of points is their centre of mass. Drag $A$, $B$, $C$."},{"control":null,"id":"item-2","kind":"expression","normalization":null,"positionSource":null,"source":"A = point(-1.5, -0.5)"},{"control":null,"id":"item-3","kind":"expression","normalization":null,"positionSource":null,"source":"B = point(0.5, 1.5)"},{"control":null,"id":"item-4","kind":"expression","normalization":null,"positionSource":null,"source":"C = point(1, -0.5)"},{"control":null,"id":"item-5","kind":"expression","normalization":null,"positionSource":null,"source":"T = [A, B, C]"},{"control":null,"id":"item-6","kind":"expression","normalization":null,"positionSource":null,"source":"a = B & C"},{"control":null,"id":"item-7","kind":"expression","normalization":null,"positionSource":null,"source":"b = C & A"},{"control":null,"id":"item-8","kind":"expression","normalization":null,"positionSource":null,"source":"c = A & B"},{"control":null,"id":"item-9","kind":"annotation","normalization":null,"positionSource":null,"source":"**Orthocentre**: the altitudes meet."},{"control":null,"id":"item-10","kind":"expression","normalization":null,"positionSource":null,"source":"oa = a | A"},{"control":null,"id":"item-11","kind":"expression","normalization":null,"positionSource":null,"source":"ob = b | B"},{"control":null,"id":"item-12","kind":"expression","normalization":null,"positionSource":null,"source":"O = oa ^ ob"},{"control":null,"id":"item-13","kind":"annotation","normalization":null,"positionSource":null,"source":"**Circumcentre**: the perpendicular bisectors meet."},{"control":null,"id":"item-14","kind":"expression","normalization":null,"positionSource":null,"source":"ca = c | (A + B)"},{"control":null,"id":"item-15","kind":"expression","normalization":null,"positionSource":null,"source":"cb = a | (B + C)"},{"control":null,"id":"item-16","kind":"expression","normalization":null,"positionSource":null,"source":"K = ca ^ cb"},{"control":null,"id":"item-17","kind":"annotation","normalization":null,"positionSource":null,"source":"**Centroid**, and the line:"},{"control":null,"id":"item-18","kind":"expression","normalization":null,"positionSource":null,"source":"G = A + B + C"},{"control":null,"id":"item-19","kind":"expression","normalization":null,"positionSource":null,"source":"E = O & K"}],"languageVersion":2,"metadata":{"description":"The orthocentre, the circumcentre, and the centroid of a triangle lie on one line.","title":"Euler's line"},"view":{"display":{"axisLabelsVisible":true,"decimalPlaces":4,"graduationsVisible":true,"gridVisible":true,"labelsVisible":true,"objectScale":1,"showApproximatedResidue":false,"theme":"system","valuesVisible":true},"positionEnabled":true,"viewport":{"centerX":0,"centerY":0,"kind":"two-dimensional","zoom":110},"visualizerId":"org.multivector.pga-2d"}}
