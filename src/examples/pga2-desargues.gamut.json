lse,"fillOpacitySource":"","pointSizeSource":"","pointStyle":"dot","strokeStyle":"solid","strokeWidthSource":"","visible":true}},"sliderInCanvas":false,"strokeStyle":"solid","strokeWidthSource":"","style":"blue-4","visible":true},"item-6":{"bivectorShape":"from-vectors","borderVisible":false,"draggable":true,"idealPointDisplay":"vector","label":"","labelAnchor":"auto","labelAngleSource":"","labelDistanceSource":"","labelOnly":false,"labelSizeSource":"","labelVisible":true,"opacitySource":"","orientationVisible":true,"pointSizeSource":"","pointStyle":"dot","primitiveStyles":{"lines":{"orientationVisible":true,"strokeStyle":"solid","strokeWidthSource":"","visible":true},"points":{"connection":"none","fill":false,"fillOpacitySource":"","pointSizeSource":"","pointStyle":"dot","strokeStyle":"solid","strokeWidthSource":"","visible":true}},"sliderInCanvas":false,"strokeStyle":"solid","strokeWidthSource":"","style":"green-5","visible":true},"item-7":{"bivectorShape":"from-vectors","borderVisible":false,"draggable":true,"idealPointDisplay":"vector","label":"","labelAnchor":"auto","labelAngleSource":"","labelDistanceSource":"","labelOnly":false,"labelSizeSource":"","labelVisible":true,"opacitySource":"","orientationVisible":true,"pointSizeSource":"","pointStyle":"dot","primitiveStyles":{"lines":{"orientationVisible":true,"strokeStyle":"solid","strokeWidthSource":"","visible":true},"points":{"connection":"none","fill":false,"fillOpacitySource":"","pointSizeSource":"","pointStyle":"dot","strokeStyle":"solid","strokeWidthSource":"","visible":true}},"sliderInCanvas":false,"strokeStyle":"solid","strokeWidthSource":"","style":"green-5","visible":true},"item-8":{"bivectorShape":"from-vectors","borderVisible":false,"draggable":true,"idealPointDisplay":"vector","label":"","labelAnchor":"auto","labelAngleSource":"","labelDistanceSource":"","labelOnly":false,"labelSizeSource":"","labelVisible":true,"opacitySource":"","orientationVisible":true,"pointSizeSource":"","pointStyle":"dot","primitiveStyles":{"lines":{"orientationVisible":true,"strokeStyle":"solid","strokeWidthSource":"","visible":true},"points":{"connection":"none","fill":false,"fillOpacitySource":"","pointSizeSource":"","pointStyle":"dot","strokeStyle":"solid","strokeWidthSource":"","visible":true}},"sliderInCanvas":false,"strokeStyle":"solid","strokeWidthSource":"","style":"green-5","visible":true},"item-9":{"bivectorShape":"from-vectors","borderVisible":false,"draggable":true,"idealPointDisplay":"vector","label":"","labelAnchor":"auto","labelAngleSource":"","labelDistanceSource":"","labelOnly":false,"labelSizeSource":"","labelVisible":false,"opacitySource":"","orientationVisible":true,"pointSizeSource":"","pointStyle":"dot","primitiveStyles":{"lines":{"orientationVisible":true,"strokeStyle":"solid","strokeWidthSource":"","visible":true},"points":{"connection":"closed-loop","fill":false,"fillOpacitySource":"","pointSizeSource":"","pointStyle":"dot","strokeStyle":"solid","strokeWidthSource":"","visible":false}},"sliderInCanvas":false,"strokeStyle":"solid","strokeWidthSource":"","style":"purple-3","visible":true}},"folders":[],"formatVersion":13,"id":"example-pga2-desargues","interpretation":{"interpretationId":"org.multivector.pga-2d","interpretationVersion":1},"items":[{"control":null,"id":"item-1","kind":"annotation","normalization":null,"positionSource":null,"source":"# Desargues' theorem\nThe triangles $XYZ$ and $xyz$ are in perspective from $O$: each small vertex lies on a line through $O$. Then the meets of their corresponding sides lie on one line, the **axis of perspectivity**. Drag $O$, $X$, $Y$, $Z$."},{"control":null,"id":"item-2","kind":"expression","normalization":null,"positionSource":null,"source":"O = point(-1.4, -0.5)"},{"control":null,"id":"item-3","kind":"expression","normalization":null,"positionSource":null,"source":"X = point(1, 1)"},{"control":null,"id":"item-4","kind":"expression","normalization":null,"positionSource":null,"source":"Y = point(0.2, 1.2)"},{"control":null,"id":"item-5","kind":"expression","normalization":null,"positionSource":null,"source":"Z = point(0.75, 0.5)"},{"control":null,"id":"item-6","kind":"expression","normalization":null,"positionSource":null,"source":"x = 0.5 * O + 0.4 * X"},{"control":null,"id":"item-7","kind":"expression","normalization":null,"positionSource":null,"source":"y = 0.4 * O + 0.6 * Y"},{"control":null,"id":"item-8","kind":"expression","normalization":null,"positionSource":null,"source":"z = 0.7 * O + 0.3 * Z"},{"control":null,"id":"item-9","kind":"expression","normalization":null,"positionSource":null,"source":"T1 = [X, Y, Z]"},{"control":null,"id":"item-10","kind":"expression","normalization":null,"positionSource":null,"source":"T2 = [x, y, z]"},{"control":null,"id":"item-11","kind":"expression","normalization":null,"positionSource":null,"source":"OX = O & X"},{"control":null,"id":"item-12","kind":"expression","normalization":null,"positionSource":null,"source":"OY = O & Y"},{"control":null,"id":"item-13","kind":"expression","normalization":null,"positionSource":null,"source":"OZ = O & Z"},{"control":null,"id":"item-14","kind":"annotation","normalization":null,"positionSource":null,"source":"Corresponding sides meet in $P_1$, $P_2$, $P_3$:"},{"control":null,"id":"item-15","kind":"expression","normalization":null,"positionSource":null,"source":"P1 = (Y & X) ^ (y & x)"},{"control":null,"id":"item-16","kind":"expression","normalization":null,"positionSource":null,"source":"P2 = (Y & Z) ^ (y & z)"},{"control":null,"id":"item-17","kind":"expression","normalization":null,"positionSource":null,"source":"P3 = (X & Z) ^ (x & z)"},{"control":null,"id":"item-18","kind":"expression","normalization":null,"positionSource":null,"source":"axis = P1 & P3"}],"languageVersion":2,"metadata":{"description":"Two triangles in perspective from a point are in perspective from a line.","title":"Desargues' theorem"},"view":{"display":{"axisLabelsVisible":true,"decimalPlaces":4,"graduationsVisible":true,"gridVisible":true,"labelsVisible":true,"objectScale":1,"showApproximatedResidue":false,"theme":"system","valuesVisible":true},"positionEnabled":true,"viewport":{"centerX":0,"centerY":0,"kind":"two-dimensional","zoom":150},"visualizerId":"org.multivector.pga-2d"}}
