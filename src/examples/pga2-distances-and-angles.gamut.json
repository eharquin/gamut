Visible":true,"strokeStyle":"solid","strokeWidthSource":"","visible":true},"points":{"connection":"closed-loop","fill":false,"fillOpacitySource":"","pointSizeSource":"","pointStyle":"dot","strokeStyle":"solid","strokeWidthSource":"","visible":false}},"sliderInCanvas":false,"strokeStyle":"solid","strokeWidthSource":"","style":"green-2","visible":true},"item-7":{"bivectorShape":"from-vectors","borderVisible":false,"draggable":true,"idealPointDisplay":"vector","label":"","labelAnchor":"auto","labelAngleSource":"","labelDistanceSource":"","labelOnly":false,"labelSizeSource":"","labelVisible":false,"opacitySource":"","orientationVisible":true,"pointSizeSource":"","pointStyle":"dot","primitiveStyles":{"lines":{"orientationVisible":true,"strokeStyle":"solid","strokeWidthSource":"","visible":true},"points":{"connection":"none","fill":false,"fillOpacitySource":"","pointSizeSource":"","pointStyle":"dot","strokeStyle":"solid","strokeWidthSource":"","visible":true}},"sliderInCanvas":false,"strokeStyle":"solid","strokeWidthSource":"","style":"teal-4","visible":true},"item-8":{"bivectorShape":"from-vectors","borderVisible":false,"draggable":true,"idealPointDisplay":"vector","label":"","labelAnchor":"auto","labelAngleSource":"","labelDistanceSource":"","labelOnly":false,"labelSizeSource":"","labelVisible":false,"opacitySource":"","orientationVisible":true,"pointSizeSource":"","pointStyle":"dot","primitiveStyles":{"lines":{"orientationVisible":true,"strokeStyle":"solid","strokeWidthSource":"","visible":true},"points":{"connection":"none","fill":false,"fillOpacitySource":"","pointSizeSource":"","pointStyle":"dot","strokeStyle":"solid","strokeWidthSource":"","visible":true}},"sliderInCanvas":false,"strokeStyle":"solid","strokeWidthSource":"","style":"teal-4","visible":true},"item-9":{"bivectorShape":"from-vectors","borderVisible":false,"draggable":true,"idealPointDisplay":"vector","label":"","labelAnchor":"auto","labelAngleSource":"","labelDistanceSource":"","labelOnly":false,"labelSizeSource":"","labelVisible":false,"opacitySource":"","orientationVisible":true,"pointSizeSource":"","pointStyle":"dot","primitiveStyles":{"lines":{"orientationVisible":true,"strokeStyle":"solid","strokeWidthSource":"","visible":true},"points":{"connection":"none","fill":false,"fillOpacitySource":"","pointSizeSource":"","pointStyle":"dot","strokeStyle":"solid","strokeWidthSource":"","visible":true}},"sliderInCanvas":false,"strokeStyle":"solid","strokeWidthSource":"","style":"teal-4","visible":true}},"folders":[],"formatVersion":13,"id":"example-pga2-distances-and-angles","interpretation":{"interpretationId":"org.multivector.pga-2d","interpretationVersion":1},"items":[{"control":null,"id":"item-1","kind":"annotation","normalization":null,"positionSource":null,"source":"# Distances and angles\nWith unit elements, the distance between two points, or a point and a line, is the norm of their **join** $\\lVert A \\vee B \\rVert$, and the angle between two lines is $\\arccos(L \\cdot M)$. $A$ moves with $t$; drag $B$ and $C$."},{"control":{"animation":{"direction":"forward","durationSeconds":6,"mode":"loop"},"maximumSource":"tau","minimumSource":"0","mode":"slider","stepSource":"0.01"},"id":"item-2","kind":"expression","normalization":null,"positionSource":null,"source":"t = 0"},{"control":null,"id":"item-3","kind":"expression","normalization":null,"positionSource":null,"source":"A = point(-1, -0.5 * sin(t))"},{"control":null,"id":"item-4","kind":"expression","normalization":null,"positionSource":null,"source":"B = point(-1, 1)"},{"control":null,"id":"item-5","kind":"expression","normalization":null,"positionSource":null,"source":"C = point(1, 1)"},{"control":null,"id":"item-6","kind":"expression","normalization":null,"positionSource":null,"source":"T = [A, B, C]"},{"control":null,"id":"item-7","kind":"expression","normalization":null,"positionSource":null,"source":"AB = (B & A) / (B & A).norm"},{"control":null,"id":"item-8","kind":"expression","normalization":null,"positionSource":null,"source":"BC = (C & B) / (C & B).norm"},{"control":null,"id":"item-9","kind":"expression","normalization":null,"positionSource":null,"source":"CA = (C & A) / (C & A).norm"},{"control":null,"id":"item-10","kind":"expression","normalization":null,"positionSource":null,"source":"dAB = (A & B).norm"},{"control":null,"id":"item-11","kind":"expression","normalization":null,"positionSource":null,"source":"dBC = (B & C).norm"},{"control":null,"id":"item-12","kind":"expression","normalization":null,"positionSource":null,"source":"dCA = (C & A).norm"},{"control":null,"id":"item-13","kind":"annotation","normalization":null,"positionSource":null,"source":"The foot $F$ of the perpendicular from $B$ to $CA$, and the distance from $B$ to that line:"},{"control":null,"id":"item-14","kind":"expression","normalization":null,"positionSource":null,"source":"F = (B | CA) * CA"},{"control":null,"id":"item-15","kind":"expression","normalization":null,"positionSource":null,"source":"H = [B, F]"},{"control":null,"id":"item-16","kind":"expression","normalization":null,"positionSource":null,"source":"dB = (B & CA).norm"},{"control":null,"id":"item-17","kind":"annotation","normalization":null,"positionSource":null,"source":"Angles at the vertices, in degrees:"},{"control":null,"id":"item-18","kind":"expression","normalization":null,"positionSource":null,"source":"angA = acos(CA | AB) * 180 / pi"},{"control":null,"id":"item-19","kind":"expression","normalization":null,"positionSource":null,"source":"angB = acos(BC | AB) * 180 / pi"},{"control":null,"id":"item-20","kind":"expression","normalization":null,"positionSource":null,"source":"angC = acos(CA | BC) * 180 / pi"}],"languageVersion":1,"metadata":{"description":"The norm of a join is a distance, and the inner product of two unit lines the cosine of their angle.","title":"Distances and angles"},"view":{"display":{"axisLabelsVisible":true,"decimalPlaces":4,"graduationsVisible":true,"gridVisible":true,"labelsVisible":true,"objectScale":1,"showApproximatedResidue":false,"theme":"system","valuesVisible":true},"positionEnabled":true,"viewport":{"centerX":0,"centerY":0,"kind":"two-dimensional","zoom":130},"visualizerId":"org.multivector.pga-2d"}}
